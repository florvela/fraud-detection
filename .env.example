# =============================================================================
# Variables de entorno del stack (SAIF capa 4 — gestión de secretos).
#
# Copiá este archivo a `.env` y poné tus valores. `.env` está en .gitignore: los
# secretos NUNCA se versionan ni se hornean en las imágenes. `docker compose` lee
# este archivo automáticamente y lo inyecta en los servicios.
#
#   cp .env.example .env
#
# Todos tienen un default seguro para la demo en docker-compose.yml (${VAR:-default}),
# así que el stack levanta aunque no definas .env — pero en "producción" deberías
# cambiarlos por valores fuertes.
# =============================================================================

# --- Autenticación / RBAC del serving REST (capa 1) --------------------------
# Listas separadas por coma. El token admin puede TODO; analyst sólo revisión;
# mlops sólo entrenar/evaluar/deployar.
API_KEYS=token-secreto-123
ANALYST_API_KEYS=analyst-key
MLOPS_API_KEYS=mlops-key
API_KEY=token-secreto-123          # el que usan la UI y el loadtest (token admin)

# --- Autenticación del núcleo gRPC (capa 1) ----------------------------------
GRPC_API_KEYS=token-secreto-123    # keys que ACEPTA el servidor gRPC
GRPC_API_KEY=token-secreto-123     # key que PRESENTA el borde REST

# --- Rate limiting (capa 3) y auditoría (capa 8) -----------------------------
RATE_LIMIT=60/minute               # para la demo del 429, bajalo a p.ej. 5/minute

# --- Secretos de infraestructura (capa 4) ------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AIRFLOW_SECRET_KEY=fraud-demo-secret-key-local
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Defensas del aprendizaje federado (capa 5) ------------------------------
# Default = FedAvg sin defensa. Para el cluster real "defendido":
#   FED_AGG=median  FED_CLIP_NORM=3  FED_DP_NOISE=0.01
# Para simular un banco malicioso (en fed-client-b): FED_POISON=1
FED_AGG=fedavg
FED_CLIP_NORM=0
FED_DP_NOISE=0
FED_POISON=0
